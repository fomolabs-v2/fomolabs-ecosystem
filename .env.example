# Optional higher-capacity Jupiter access. Never use NEXT_PUBLIC_ for secrets.
JUPITER_API_KEY=
# Dedicated production Solana RPC; public mainnet is the fallback.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional second provider for read failover.
SOLANA_RPC_FALLBACK_URL=
# Private store for confirmed FOMO DEX volume. Vercel supplies OIDC automatically.
BLOB_STORE_ID=
# Alternative for hosting outside Vercel; keep server-only.
BLOB_READ_WRITE_TOKEN=
